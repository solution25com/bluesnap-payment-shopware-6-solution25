{% block solu1_bluesnap_credit_card %}
    <div id="bluesnap-credit-card" class="bluesnap-credit-card"
         data-bluesnap-credit-card="true"
         data-pf-token="{{ page.extensions.bluesnap.pfToken is iterable ? '' : page.extensions.bluesnap.pfToken }}"
         data-vaulted-shopper-id="{{ page.extensions.bluesnap.vaultedShopperId }}"
         data-preferred-card-key="{{ page.extensions.bluesnap.preferredCardKey }}"
         data-selected-card-key="{{ page.extensions.bluesnap.selectedCardKey }}"
         data-has-saved-cards="{{ page.extensions.bluesnap.hasSavedCards ? '1' : '0' }}"
         data-secured-firstName="{{ page.extensions.bluesnap.securedFirstName }}"
         data-secured-lastName="{{ page.extensions.bluesnap.securedLastName }}"
         data-secured-amount="{{ page.extensions.bluesnap.securedAmount }}"
         data-secured-currency="{{ page.extensions.bluesnap.securedCurrency }}"
         data-surcharge-token="{{ page.extensions.bluesnap.surchargeToken|default('') }}"
         data-surcharge-amount="{{ page.extensions.bluesnap.surchargeAmount|default('') }}"
         data-three-d-secure="{{ page.extensions.bluesnap.threeDS }}"
         data-flow="{{ page.extensions.bluesnap.flow }}"
         data-script-url="{{ page.extensions.bluesnap.js_link }}"
         data-is-surcharge-active="{{ page.extensions.bluesnap.isSurchargeActive ? '1' : '0' }}"
         data-surcharge-notice-text="{{ 'Bluesnap.surcharge.notice'|trans|striptags }}"
         data-validation-error-text="{{ 'Bluesnap.credit-card.errors.requiredFields'|trans|striptags }}"
         data-generic-error-text="{{ 'Bluesnap.credit-card.errors.generic'|trans|striptags }}"
         data-three-d-secure-failed-text="{{ 'Bluesnap.credit-card.errors.threeDSecureFailed'|trans|striptags }}"
    >
        {% block bluesnap_credit_card_error %}
            <div class="alert alert-danger d-none" id="bluesnap-error-message" role="alert">
                <div class="error-alert">
                    <div class="svg-icon">
                        {% sw_icon 'alert' style {'pack':'customsvg'} %}
                    </div>
                    <p></p>
                </div>
            </div>
        {% endblock %}

        {% block bluesnap_credit_card_saved_cards %}
            {% if page.extensions.bluesnap.hasSavedCards %}
                <div class="bluesnap-saved-cards-choice" data-bluesnap-saved-cards-choice>
                    <p class="bluesnap-saved-cards-choice-title">
                        {{ 'Bluesnap.savedCards.checkoutTitle'|trans|sw_sanitize }}
                    </p>

                    {% for card in page.extensions.bluesnap.savedCards %}
                        <div class="bluesnap-saved-card-option form-check payment-method-radio{{ card.expired ? ' bluesnap-saved-card-option--expired' : '' }}">
                            <input class="form-check-input bluesnap-saved-card-radio"
                                   type="radio"
                                   name="bluesnap_card_choice"
                                   id="bluesnap-card-{{ card.cardKey }}"
                                   value="{{ card.cardKey }}"
                                   data-bluesnap-card-type="{{ card.cardType }}"
                                   data-bluesnap-card-last-four="{{ card.lastFourDigits }}"
                                   {{ card.expired ? 'disabled' : '' }}
                                   {{ card.cardKey == page.extensions.bluesnap.selectedCardKey ? 'checked' : '' }}>
                            <label class="form-check-label bluesnap-saved-card-label" for="bluesnap-card-{{ card.cardKey }}">
                                <span class="bluesnap-saved-card-brand">{{ card.cardType }}</span>
                                <span class="bluesnap-saved-card-number">&bull;&bull;&bull;&bull;&nbsp;{{ card.lastFourDigits }}</span>
                                {% if card.expirationDate %}
                                    <span class="bluesnap-saved-card-expiry text-muted">({{ card.expirationDate }})</span>
                                {% endif %}
                                {% if card.cardKey == page.extensions.bluesnap.preferredCardKey %}
                                    <span class="bluesnap-saved-card-preferred-badge">{{ 'Bluesnap.savedCards.preferred'|trans|sw_sanitize }}</span>
                                {% endif %}
                                {% if card.expired %}
                                    <span class="bluesnap-saved-card-expired-badge">{{ 'Bluesnap.savedCards.expired'|trans|sw_sanitize }}</span>
                                {% endif %}
                            </label>
                        </div>
                    {% endfor %}

                    <div class="bluesnap-saved-card-option form-check payment-method-radio">
                        <input class="form-check-input bluesnap-saved-card-radio"
                               type="radio"
                               name="bluesnap_card_choice"
                               id="bluesnap-card-new"
                               value="new"
                               {{ page.extensions.bluesnap.selectedCardKey ? '' : 'checked' }}>
                        <label class="form-check-label bluesnap-saved-card-label" for="bluesnap-card-new">
                            {{ 'Bluesnap.savedCards.useNewCard'|trans|sw_sanitize }}
                        </label>
                    </div>
                </div>
            {% endif %}
        {% endblock %}

        {% block bluesnap_credit_card_new_card %}
            <div class="bluesnap-new-card{{ page.extensions.bluesnap.selectedCardKey ? ' d-none' : '' }}"
                 id="bluesnap-new-card"
                 data-bluesnap-new-card>
                <div class="row">
                    <div class="form-group col-md-6">
                        <input type="text" class="form-control" id="bluesnap-first-name"
                               autocomplete="cc-given-name"
                               aria-label="{{ 'Bluesnap.credit-card.fields.first-name-placeholder'|trans|striptags }}"
                               placeholder="{{ 'Bluesnap.credit-card.fields.first-name-placeholder'|trans }}">
                    </div>

                    <div class="form-group col-md-6">
                        <input type="text" class="form-control" id="bluesnap-last-name"
                               autocomplete="cc-family-name"
                               aria-label="{{ 'Bluesnap.credit-card.fields.last-name-placeholder'|trans|striptags }}"
                               placeholder="{{ 'Bluesnap.credit-card.fields.last-name-placeholder'|trans }}">
                    </div>

                    <div class="form-group col-md-12">
                        <div class="input-group">
                            <div class="form-control" id="bluesnap-ccn" data-bluesnap="ccn"></div>
                        </div>
                        <p class="helper-text-ccn">{{ 'Bluesnap.credit-card.fields.helper-text'|trans|raw }}</p>
                    </div>

                    <div class="form-group col-md-4">
                        <div class="form-control" id="bluesnap-exp" data-bluesnap="exp"></div>
                    </div>

                    <div class="form-group col-md-4">
                        <div class="form-control" id="bluesnap-cvv" data-bluesnap="cvv"></div>
                    </div>

                    <div class="secure-payments col-md-4 col-12">
                        {% sw_icon 'lock' style {'pack':'customsvg'} %}
                        <p>{{ 'Bluesnap.credit-card.fields.secure-payments'|trans }}</p>
                    </div>
                </div>

                {% if not page.extensions.bluesnap.isGuestLogin and page.extensions.bluesnap.vaultedShopperEnable %}
                    <div class="saved-infos">
                        <input type="checkbox" id="bluesnap-save-card" class="bluesnap-save-card-initial">
                        <label class="bluesnap-save-card" for="bluesnap-save-card">{{ 'Bluesnap.credit-card.fields.save-card-info'|trans }}</label>
                    </div>
                {% endif %}
            </div>
        {% endblock %}

        {% block bluesnap_credit_card_surcharge_confirm %}
            {% if page.extensions.bluesnap.isSurchargeActive %}
                <div class="bluesnap-surcharge-confirm d-none"
                     id="bluesnap-surcharge-confirm"
                     role="alert"
                     aria-live="polite"
                     data-bluesnap-surcharge-confirm>
                    <p class="bluesnap-surcharge-confirm-text" id="bluesnap-surcharge-confirm-text"></p>
                    <div class="bluesnap-surcharge-confirm-actions">
                        <button type="button"
                                class="btn btn-primary"
                                id="bluesnap-surcharge-confirm-pay"
                                data-bluesnap-surcharge-pay>
                            {{ 'Bluesnap.surcharge.confirmPay'|trans|sw_sanitize }}
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="bluesnap-surcharge-confirm-cancel"
                                data-bluesnap-surcharge-cancel>
                            {{ 'Bluesnap.surcharge.confirmCancel'|trans|sw_sanitize }}
                        </button>
                    </div>
                </div>
            {% endif %}
        {% endblock %}

        {% block bluesnap_credit_card_loader %}
            <div class="bluesnap-loader d-none text-center w-60 h-60" id="bluesnap-loader"></div>
        {% endblock %}
    </div>
{% endblock %}
